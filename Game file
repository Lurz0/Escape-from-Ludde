<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Ludde Runner</title>
<style>
  *{box-sizing:border-box}body{margin:0;background:#101522;color:#f1f5f9;font-family:Arial,sans-serif;display:grid;place-items:center;height:100vh}
  .game{width:min(94vw,900px);text-align:center}.hud{display:flex;justify-content:space-between;font-weight:bold;margin:0 4px 10px;color:#e2e8f0}
  canvas{width:100%;height:auto;border:2px solid #334155;border-radius:8px;background:#172033;image-rendering:pixelated;box-shadow:0 4px 20px #0008}
  p{color:#94a3b8}.customize{display:flex;justify-content:center;gap:14px;align-items:center;margin:12px 0;color:#cbd5e1;font-size:.9rem}input,select{background:#1e293b;color:#fff;border:1px solid #475569;border-radius:4px;padding:5px}button{padding:9px 18px;border:0;border-radius:5px;background:#2563eb;color:white;cursor:pointer;font-size:1rem}
</style>
</head>
<body>
<main class="game">
  <div class="hud"><span>Escape from Ludde</span><span id="score">0</span></div>
  <canvas id="screen" width="900" height="300" aria-label="Ludde Runner game"></canvas>
  <div class="customize"><label>Suit <input id="suit" type="color" value="#2563eb"></label><label>Hat <select id="hat"><option value="none">No hat</option><option value="cap">Cap</option><option value="helmet">Helmet</option></select></label></div>
  <p id="message">Press Start to play!</p><button id="restart">Start game</button>
  <div id="scores" hidden><h3>High scores</h3><ol id="scoreList"></ol></div>
</main>
<script>
const canvas=document.querySelector('#screen'),ctx=canvas.getContext('2d'),scoreEl=document.querySelector('#score'),msg=document.querySelector('#message'),restart=document.querySelector('#restart'),suit=document.querySelector('#suit'),hat=document.querySelector('#hat'),scoresBox=document.querySelector('#scores'),scoreList=document.querySelector('#scoreList');
let ludde,obstacles,score,speed,playing=false,last,ground=252,highScore=Number(localStorage.getItem('luddeHighScore')||0),goatShown=false,fireAttack=null,fireCooldown=0;
function getScores(){return JSON.parse(localStorage.getItem('luddeScores')||'[]')}
function showScores(){scoreList.innerHTML=getScores().map((s,i)=>`<li>${s}</li>`).join('');scoresBox.hidden=false}
function reset(){ludde={x:75,y:ground-42,w:30,h:42,vy:0,jumping:false};obstacles=[];score=0;speed=6;playing=true;last=performance.now();goatShown=false;fireAttack=null;fireCooldown=0;msg.textContent='Press Space, ↑, or tap to jump!';restart.hidden=true;scoresBox.hidden=true;requestAnimationFrame(loop)}
function jump(){if(!playing)return reset();if(!ludde.jumping){ludde.vy=-13;ludde.jumping=true}}
function addObstacle(){let h=28+Math.random()*28,w=16+Math.random()*18;obstacles.push({x:920,y:ground-h,w,h})}
function drawFlyingCreatures(now){let t=now/650;for(let i=0;i<5;i++){let x=((i*213+t*(28+i*7))%1050)-80,y=48+i*25+Math.sin(t+i)*10,wing=12+Math.sin(t*2+i)*5;ctx.save();ctx.translate(x,y);ctx.rotate(Math.sin(t+i)*.12);ctx.fillStyle=['#a855f7','#06b6d4','#f43f5e','#22c55e','#f97316'][i];ctx.shadowColor=ctx.fillStyle;ctx.shadowBlur=9;ctx.beginPath();ctx.ellipse(0,0,15,5,0,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.moveTo(-4,0);ctx.quadraticCurveTo(-18,-wing,-25,-3);ctx.quadraticCurveTo(-13,5,-3,4);ctx.moveTo(4,0);ctx.quadraticCurveTo(18,-wing,25,-3);ctx.quadraticCurveTo(13,5,3,4);ctx.fill();ctx.fillStyle='#fef08a';ctx.fillRect(7,-2,3,3);ctx.restore()}}
function drawGodzilla(now){if(score<50||score>=200)return;let pulse=Math.sin(now/90)*2,baseX=650;ctx.save();ctx.globalAlpha=.96;ctx.fillStyle='#172b25';ctx.strokeStyle='#0b1715';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(baseX-75,ground);ctx.lineTo(baseX-60,175);ctx.lineTo(baseX-45,145);ctx.lineTo(baseX-28,128);ctx.lineTo(baseX-5,112);ctx.lineTo(baseX+18,120);ctx.lineTo(baseX+43,145);ctx.lineTo(baseX+65,165);ctx.lineTo(baseX+82,ground);ctx.closePath();ctx.fill();ctx.stroke();ctx.fillStyle='#365c43';ctx.beginPath();ctx.arc(baseX-2,117,27,0,Math.PI*2);ctx.fill();ctx.fillStyle='#facc15';ctx.fillRect(baseX+10,108,5,5);ctx.fillRect(baseX-13,108,5,5);ctx.fillStyle='#1f3d2b';for(let i=0;i<6;i++){ctx.beginPath();ctx.moveTo(baseX-48+i*18,145+i%2*5);ctx.lineTo(baseX-40+i*18,122+i%2*5);ctx.lineTo(baseX-30+i*18,145+i%2*5);ctx.fill()}ctx.fillStyle='#f97316';ctx.shadowColor='#ef4444';ctx.shadowBlur=18;ctx.beginPath();ctx.moveTo(baseX+23,125);ctx.quadraticCurveTo(baseX+105,115+pulse,baseX+190,130);ctx.quadraticCurveTo(baseX+115,145+pulse,baseX+23,135);ctx.fill();ctx.fillStyle='#fde047';ctx.beginPath();ctx.moveTo(baseX+28,129);ctx.quadraticCurveTo(baseX+105,124+pulse,baseX+165,131);ctx.quadraticCurveTo(baseX+105,136+pulse,baseX+28,133);ctx.fill();ctx.restore()}
function drawHydra(now){if(score<200)return;let pulse=Math.sin(now/80)*10,baseX=670;ctx.save();ctx.strokeStyle='#dbeafe';ctx.lineWidth=3;ctx.shadowColor='#60a5fa';ctx.shadowBlur=16;for(let i=0;i<5;i++){let x=baseX-55+i*28;ctx.beginPath();ctx.moveTo(x,ground);ctx.lineTo(x-12,190);ctx.lineTo(x+Math.sin(now/120+i)*8,125);ctx.stroke();ctx.fillStyle='#7c3aed';ctx.beginPath();ctx.arc(x+Math.sin(now/120+i)*8,115,16,0,Math.PI*2);ctx.fill();ctx.fillStyle='#fef08a';ctx.fillRect(x-6+Math.sin(now/120+i)*8,110,4,4);ctx.fillRect(x+5+Math.sin(now/120+i)*8,110,4,4)}ctx.strokeStyle='#e0f2fe';ctx.lineWidth=5;for(let i=0;i<4;i++){let x=60+i*230;ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x+45,65+pulse);ctx.lineTo(x-20,135);ctx.lineTo(x+35,ground-55);ctx.stroke()}ctx.restore()}
function drawBackground(now){let t=now/1000;ctx.fillStyle='#172033';ctx.fillRect(0,0,900,300);ctx.fillStyle='#263653';for(let i=0;i<9;i++){let x=(i*137-(t*18)%137);ctx.beginPath();ctx.arc(x,65+(i%3)*18,2+(i%2)*2,0,7);ctx.fill()}drawFlyingCreatures(now);drawGodzilla(now);drawHydra(now);ctx.fillStyle='#334155';for(let i=0;i<8;i++){let x=(i*150-(t*35)%150);ctx.fillRect(x,ground-35-(i%2)*18,70,35+(i%2)*18)}ctx.fillStyle='#fbbf24';ctx.globalAlpha=.8;ctx.beginPath();ctx.arc(790,55,24,0,7);ctx.fill();ctx.globalAlpha=1}
function drawLudde(){let c=suit.value;ctx.fillStyle=c;ctx.fillRect(ludde.x+7,ludde.y+12,16,25);ctx.fillStyle='#f2b27b';ctx.beginPath();ctx.arc(ludde.x+15,ludde.y+8,11,0,Math.PI*2);ctx.fill();ctx.fillStyle='#222';ctx.fillRect(ludde.x+19,ludde.y+5,3,3);if(hat.value!=='none'){ctx.fillStyle=hat.value==='helmet'?'#f59e0b':c;ctx.fillRect(ludde.x+3,ludde.y-5,24,7);ctx.fillRect(ludde.x+8,ludde.y-10,15,7)}ctx.strokeStyle=c;ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(ludde.x+10,ludde.y+37);ctx.lineTo(ludde.x+5,ludde.y+42);ctx.moveTo(ludde.x+20,ludde.y+37);ctx.lineTo(ludde.x+26,ludde.y+42);ctx.stroke()}
function drawDino(o){ctx.fillStyle=o.color||'#65a30d';ctx.fillRect(o.x+7,o.y+10,o.w-12,o.h-10);ctx.beginPath();ctx.arc(o.x+7,o.y+9,9,0,7);ctx.fill();ctx.fillStyle='#111';ctx.fillRect(o.x+9,o.y+5,2,2);ctx.fillStyle='#84cc16';ctx.fillRect(o.x+2,o.y+o.h-3,7,3)}
function gameOver(){playing=false;const finalScore=Math.floor(score),scores=[...getScores(),finalScore].sort((a,b)=>b-a).slice(0,5);localStorage.setItem('luddeScores',JSON.stringify(scores));if(finalScore>highScore){highScore=finalScore;localStorage.setItem('luddeHighScore',highScore)}msg.textContent='Game over!';restart.textContent='Start game';restart.hidden=false;showScores()}
function loop(now){if(!playing)return;let dt=Math.min((now-last)/16.67,2);last=now;drawBackground(now);ctx.strokeStyle='#64748b';ctx.beginPath();ctx.moveTo(0,ground);ctx.lineTo(900,ground);ctx.stroke();
 ludde.vy+=.65*dt;ludde.y+=ludde.vy*dt;if(ludde.y>=ground-ludde.h){ludde.y=ground-ludde.h;ludde.vy=0;ludde.jumping=false}drawLudde();
 if(score>=50&&score<200){
  fireCooldown-=dt;
  if(!fireAttack&&fireCooldown<=0){fireAttack={x:850,y:ground-30,w:34,h:18};fireCooldown=260;msg.textContent='Godzilla is attacking! Jump over the fire!'}
  if(fireAttack){fireAttack.x-=9*dt;ctx.fillStyle='#f97316';ctx.shadowColor='#ef4444';ctx.shadowBlur=12;ctx.beginPath();ctx.ellipse(fireAttack.x,fireAttack.y+9,fireAttack.w/2,fireAttack.h/2,0,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;if(ludde.x<fireAttack.x+fireAttack.w&&ludde.x+ludde.w>fireAttack.x&&ludde.y<fireAttack.y+fireAttack.h&&ludde.y+ludde.h>fireAttack.y)gameOver();if(fireAttack.x+fireAttack.w<0)fireAttack=null}
 }
 if(score>=200)fireAttack=null;
 if(!goatShown&&score>highScore){goatShown=true;msg.textContent='You are goated';}
 if(!obstacles.length||obstacles.at(-1).x<600&&Math.random()<.025*dt){let type=Math.random();let h=type<.45?28+Math.random()*28:38,w=type<.45?16+Math.random()*18:34;obstacles.push({x:920,y:ground-h,w,h,type:type<.45?'rock':type<.75?'dino':'cactus',color:'#65a30d'})}for(const o of obstacles){o.x-=speed*dt;if(o.type==='dino')drawDino(o);else{ctx.fillStyle=o.type==='cactus'?'#16a34a':'#a16207';ctx.fillRect(o.x,o.y,o.w,o.h);if(o.type==='cactus'){ctx.fillRect(o.x-7,o.y+14,8,6);ctx.fillRect(o.x+o.w-1,o.y+22,8,6)}}if(ludde.x<o.x+o.w&&ludde.x+ludde.w>o.x&&ludde.y<o.y+o.h&&ludde.y+ludde.h>o.y)gameOver()}obstacles=obstacles.filter(o=>o.x+o.w>0);score+=dt*.1;speed+=.002*dt;scoreEl.textContent=Math.floor(score).toString().padStart(5,'0');requestAnimationFrame(loop)}
addEventListener('keydown',e=>{if(['Space','ArrowUp'].includes(e.code)){e.preventDefault();jump()}});canvas.addEventListener('pointerdown',jump);restart.onclick=reset;showScores();
</script>
</body></html>
